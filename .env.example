# Biến môi trường cho docker compose và khi deploy. Sao chép thành .env rồi điền giá trị thật.
# KHÔNG commit file .env. Chi tiết từng app: apps/api/.env.example.

# API (apps/api)
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5434/brewlite_db
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PAYMENT_PROVIDER=mock
SEED_ON_START=false

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
