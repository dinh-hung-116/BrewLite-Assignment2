# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5434/brewlite_db
PORT=3001
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me
ORDER_HOLD_MINUTES=15

# Cổng thanh toán VNPay sandbox (tuỳ chọn, chỉ dùng khi PAYMENT_PROVIDER=vnpay)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
