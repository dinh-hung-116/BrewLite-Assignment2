@startuml deployment
' UML Deployment diagram – production (Task 3.2), theo ADR-006
skinparam shadowing false
left to right direction

node "Thiết bị người dùng" as Dev {
  node "Trình duyệt di động / PWA" as Browser
}

node "Tailscale" as TS {
  node "Funnel relay\nHTTPS, chứng chỉ *.ts.net" as Funnel
}

node "GitHub" as GH {
  node "GitHub-hosted runner\n<<CI/CD>>" as Runner {
    artifact "ci.yml / cd.yml" as WF
  }
  node "GitHub Container Registry\nghcr.io" as GHCR {
    artifact "brewlite-api:<commit-sha>" as ImgApi
    artifact "brewlite-web:<commit-sha>" as ImgWeb
  }
  node "GitHub Secrets" as Sec
}

node "Máy server của nhóm\n<<device>> Docker Engine" as Server {
  node "tailscaled\n(funnel 443 → :3000, 8443 → :3001)" as TSD
  node "Self-hosted runner\nnhãn brewlite-prod" as SHR
  node "docker compose\n(docker-compose.prod.yml)" as Compose {
    node "web container\n127.0.0.1:3000" as WebNode {
      artifact "brewlite-web:<commit-sha>\nNext.js" as WebArt
    }
    node "api container\n127.0.0.1:3001" as ApiNode {
      artifact "brewlite-api:<commit-sha>\nNestJS + Prisma" as ApiArt
      component "GET /health" as Health
    }
    database "PostgreSQL 16\nvolume db_data\n(không mở cổng)" as PG
  }
}

Browser --> Funnel : HTTPS 443 (web)\nHTTPS 8443 (API, CORS)
Funnel --> TSD : đường hầm WireGuard
TSD --> WebArt : HTTP 127.0.0.1:3000
TSD --> ApiArt : HTTP 127.0.0.1:3001
ApiArt --> PG : TCP 5432 trong mạng Docker\nDATABASE_URL
Runner --> GHCR : docker push (tag = SHA)
Runner --> SHR : job deploy / rollback
SHR --> Compose : docker compose pull + up\nprisma migrate deploy
GHCR --> Compose : pull image
Runner --> Funnel : smoke test /health, /products, /
Sec ..> SHR : JWT_SECRET, POSTGRES_PASSWORD

note bottom of Compose
  Secret truyền qua biến môi trường của job,
  không nằm trong repository.
end note
@enduml
