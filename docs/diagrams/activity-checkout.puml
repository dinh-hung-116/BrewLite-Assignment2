@startuml activity-checkout
' Activity diagram luồng end-to-end: menu -> đặt đơn -> thanh toán -> pha chế (Task 2.1)
' Bám code: tạo đơn trước, chọn Ví/Thẻ ở trang /mock-pay sau; tồn kho chỉ kiểm tra khi đặt đơn.
skinparam shadowing false
|Khách hàng|
start
:Mở BrewLite, xem menu;
:Chọn món, size, topping, số lượng;
:Thêm vào giỏ hàng\n(giỏ lưu trên trình duyệt);
:Mở giỏ hàng, nhập mã khuyến mãi (tùy chọn),\nbấm "Đặt hàng";
|Hệ thống (Web + API)|
if (Đã đăng nhập?) then (có)
else (chưa)
  :Chuyển trang đăng nhập (giỏ giữ nguyên);
  |Khách hàng|
  :Đăng nhập / đăng ký;
  |Hệ thống (Web + API)|
endif
:POST /orders: validate, tự tính lại giá,\nkiểm tra mã khuyến mãi;
if (Dữ liệu và mã hợp lệ?) then (có)
else (không)
  :Báo lỗi 400 kèm lý do;
  |Khách hàng|
  stop
endif
|Hệ thống (Web + API)|
:Transaction: tạo đơn PENDING + giữ chỗ nguyên liệu;
if (Đủ nguyên liệu?) then (có)
else (thiếu)
  :Rollback, báo 409 "Món tạm hết";
  |Khách hàng|
  stop
endif
|Khách hàng|
:Chọn Ví điện tử hoặc Thẻ\n(trang thanh toán, hoặc sang VNPay sandbox);
repeat
  |Hệ thống (Web + API)|
  :Gửi yêu cầu thanh toán kèm Idempotency-Key\n(key mới cho mỗi lần thanh toán);
  |Cổng thanh toán\n(VNPay sandbox / mô phỏng)|
  :Xử lý trừ tiền, trả kết quả;
  |Hệ thống (Web + API)|
  if (Thành công?) then (có)
    :Transaction: payment SUCCESS, đơn PAID,\ntăng lượt dùng mã khuyến mãi;
    :Cộng điểm thưởng, xóa giỏ hàng;
  else (thất bại)
    :Payment FAILED, đơn PAYMENT_FAILED,\ngiữ giỏ hàng và nguyên liệu đã giữ;
  endif
repeat while (Thất bại và khách bấm "Thanh toán lại"?) is (có)
->không;
if (Đơn đã PAID?) then (có)
else (chưa)
  if (Khách tự hủy đơn?) then (có)
    :Đơn CANCELLED, hoàn trả nguyên liệu;
  else (bỏ dở)
    :Bộ hẹn giờ: đơn chờ quá 15 phút\nchuyển CANCELLED, hoàn trả nguyên liệu;
  endif
  stop
endif
|Hệ thống (Web + API)|
:Hiển thị xác nhận (mã đơn, PAID);
|Nhân viên quầy|
:Xem hàng đợi đơn đã thanh toán;
if (Đơn gặp sự cố?) then (có)
  :Hủy đơn tại quầy;
  |Hệ thống (Web + API)|
  :Đơn CANCELLED, hoàn trả nguyên liệu;
  stop
else (không)
  |Nhân viên quầy|
  :Nhận đơn → PREPARING;
  :Pha xong → READY;
endif
|Khách hàng|
:Trang chi tiết đơn tự làm mới,\nthấy "Sẵn sàng", tới quầy lấy nước;
|Nhân viên quầy|
:Giao khách → COMPLETED;
stop
@enduml
