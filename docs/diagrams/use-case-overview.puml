@startuml use-case-overview
' Use case tổng quát BrewLite (Task 1.2) – bám 19 User Story của Assignment 1 (mục 4.3)
left to right direction
skinparam shadowing false
skinparam usecaseFontSize 13
actor "Khách hàng" as Customer
actor "Nhân viên quầy\n(STAFF/ADMIN)" as Staff
actor "Cổng thanh toán\n(VNPay sandbox / mô phỏng)" as Pay
actor "Bộ hẹn giờ\n(Scheduler)" as Scheduler

rectangle "BrewLite" {
  usecase "UC-01 Xem menu" as UC01
  usecase "UC-02 Xem chi tiết,\nchọn size/topping" as UC02
  usecase "UC-03 Quản lý giỏ hàng" as UC03
  usecase "UC-04 Đăng ký" as UC04
  usecase "UC-07 Áp mã khuyến mãi" as UC07
  usecase "UC-06 Đặt đơn hàng" as UC06
  usecase "UC-13 Thanh toán lại" as UC13
  usecase "UC-08 Thanh toán đơn" as UC08
  usecase "UC-09 Xem xác nhận\nvà chi tiết đơn" as UC09
  usecase "UC-10 Xem lịch sử\nvà trạng thái đơn" as UC10
  usecase "UC-11 Hủy đơn" as UC11
  usecase "UC-05 Đăng nhập" as UC05
  usecase "UC-17 Cộng điểm thưởng" as UC17
  usecase "UC-18 Giữ chỗ nguyên liệu" as UC18
  usecase "UC-19 Hoàn trả nguyên liệu" as UC19
  usecase "UC-14 Xem hàng đợi pha chế" as UC14
  usecase "UC-12 Cập nhật trạng thái pha chế" as UC12
  usecase "UC-15 Hủy đơn tại quầy" as UC15
  usecase "UC-16 Tự hủy đơn quá hạn" as UC16
}

Customer --> UC01
Customer --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC07
Customer --> UC06
Customer --> UC13
Customer --> UC08
Customer --> UC09
Customer --> UC10
Customer --> UC11

UC07 ..> UC06 : <<extend>>
UC13 ..> UC08 : <<include>>
UC06 ..> UC05 : <<include>>
UC06 ..> UC18 : <<include>>
UC08 ..> UC06 : <<include>>
UC08 ..> UC17 : <<include>>
UC11 ..> UC19 : <<include>>
UC19 <.. UC15 : <<include>>
UC19 <.. UC16 : <<include>>

UC06 -[hidden]-> UC14
UC06 -[hidden]-> UC12
UC08 --> Pay
UC05 <-- Staff
UC14 <-- Staff
UC12 <-- Staff
UC15 <-- Staff
UC16 <-- Scheduler

note top of UC18
  Giữ nguyên liệu trong transaction tạo đơn,
  thiếu hàng trả 409; optimistic locking (NFR-05).
end note
note top of UC08
  Idempotency-Key: gửi lặp không tạo thêm
  giao dịch, không cộng điểm lần hai.
end note
@enduml
